    "metric_indicator_cardiovascular": "FC en reposo (latidos/min)",
    "metric_indicator_endurance": "VO₂ máximo (ml/kg/min) — Capacidad aeróbica",
    "metric_indicator_concentration": "Función cognitiva / Memoria de trabajo",
    "metric_indicator_regeneration": "Reparación de tejidos (%) / Hormona de Crecimiento (GH)",
    "metric_indicator_cramps": "Frecuencia de calambres musculares",
